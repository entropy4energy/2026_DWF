[VASP_INCAR_MODE_EXPLICIT]START 
SYSTEM=Si:PAW_PBE.A_cF8_227_a.A
# Added by [AFLOW_APL] begin
IBRION=8                                         # Linear Response method
LEPSILON=.TRUE.                                  # Calculate Born effective charges and dielectric tensor
# Added by [AFLOW_APL] end
# --- Stability tweaks for DFPT Born/eps calc on Si primitive cell (manual edit, v2) ---
# v1 failed with Error EDDDAV: ZHEGV returncode=1 2 384 because runner used 192 cores
# on a 2-atom cell (NBANDS=48) -> band-parallel breaks ScaLAPACK.
# Fix: rerun this sub-calc with fewer cores (48) via the launch script;
# AFLOW will then autotune NPAR/NCORE to a sane band distribution.
ALGO=Normal                                                 # DFPT requires Normal (IALGO=38)
ISMEAR=0                                                    # Gaussian smearing (Si is a semiconductor)
SIGMA=0.05
NELM=200                                                    # allow more SCF iterations for DFPT
LMAXMIX=4                                                   # safer for response-property mixing
# --- end manual tweaks ---
#PSTRESS=000       # Pressure in kBar (1kB=0.1GPa)           # for hand modification
#EDIFFG=-0.001     # For relaxed forces                      # for hand modification
#POTIM=-0.001      # default                                 # for hand modification
#NBANDS=XX                                                   # for hand modification
#IALGO=48                                                    # for hand modification
[VASP_INCAR_MODE_EXPLICIT]STOP 
