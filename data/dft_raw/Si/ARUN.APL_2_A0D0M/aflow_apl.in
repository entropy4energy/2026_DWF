SYSTEM=Si:PAW_PBE.A_cF8_227_a.A
# --- Stability tweaks for 250-atom Si supercell phonon calc (manual edit, v2) ---
# Using ALGO=All (damped) to bypass charge-density mixing pathology (Kerker
# mixing fails on this 250-atom cell with diffuse Si-3p density, leading to
# charge sloshing after step ~15). ALGO=All directly minimizes the
# wave function and avoids self-consistent charge mixing entirely.
ALGO=All
TIME=0.4                                                    # damping for ALGO=All (default 0.4 is fine)
ISMEAR=0                                                    # Gaussian smearing (Si is a semiconductor)
SIGMA=0.05
# Kerker mixing: large BMIX kills long-wavelength sloshing in big cells
AMIX=0.1
BMIX=1.5
AMIX_MAG=0.1
BMIX_MAG=1.5
NELM=200                                                    # large cell may need more SCF steps
NELMIN=6
LMAXMIX=4
# --- end manual tweaks ---
#PSTRESS=000       # Pressure in kBar (1kB=0.1GPa)           # for hand modification
#EDIFFG=-0.001     # For relaxed forces                      # for hand modification
#POTIM=-0.001      # default                                 # for hand modification
#NBANDS=XX                                                   # for hand modification
#IALGO=48                                                    # for hand modification
[VASP_INCAR_MODE_EXPLICIT]STOP 
